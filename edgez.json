{
  "version": 1,
  "name": "edgez-project",
  "buildInstance": "tiny",
  "appwriteConfig": "appwrite.config.json",
  "deploymentEngine": {
    "name": "appwrite-cli",
    "schemaVersion": 1,
    "directory": "infra",
    "install": "npm run install:solution",
    "uninstall": "npm run uninstall:solution"
  },
  "deployments": [
    {
      "id": "web",
      "type": "site",
      "name": "Hello World Simple",
      "rootDirectory": "site",
      "framework": "nextjs",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "out"
    }
  ],
  "workspace": {
    "mobile": {
      "rootDirectory": "app",
      "framework": "expo"
    },
    "firmware": {
      "rootDirectory": "firmware",
      "framework": "platformio"
    }
  }
}
